# Copy this file to .env.local and fill it from the development project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional Firebase Analytics configuration.
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase shared library client. Use a publishable key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Vite base path. Firebase Hosting uses the site root.
BASE_PATH=/
